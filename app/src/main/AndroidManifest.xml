<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Guided runs: keeps the CPU awake so the phase beeps arrive on time with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Rest timer: the end-of-rest cue vibrates, and the workout service is a foreground service
         of type specialUse (Play Console asks for a declaration of that use). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:name=".HybridApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HybridAIApp">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${googleApiKey}" />

        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="locale|layoutDirection" android:theme="@style/Theme.HybridAIApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".tracking.LocationTrackingService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Keeps a strength workout's stopwatch and rest countdown alive while the phone is locked
             between sets. There is no dedicated foreground service type for a workout timer, hence
             specialUse and the subtype below. -->
        <service
            android:name=".home.service.WorkoutSessionService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Workout rest timer and session stopwatch" />
        </service>
    </application>

</manifest>